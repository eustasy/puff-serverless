{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["./worker-configuration.d.ts", "./env.d.ts", "node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false
  },
  "include": ["functions/**/*.ts", "src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts", "env.d.ts", "types.d.ts"],
  "exclude": ["node_modules", "dist", ".wrangler"]
}
