{
	"name": "puff-serverless",
	"main": "./dist/worker/index.js",
	"compatibility_date": "2026-03-22",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./public"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "404f36162d5341429d55bde35de77b9f"
		}
	],
	"rate_limits": [
		{
			"binding": "EMAIL_CHECK_RL",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
