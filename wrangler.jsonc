{
	"name": "puff-serverless",
	"main": "./worker.ts",
	"compatibility_date": "2026-03-22",
	"compatibility_flags": ["nodejs_compat"],
	"triggers": {
		"crons": ["*/5 * * * *", "0 * * * *"]
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/account", "/logout"]
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "404f36162d5341429d55bde35de77b9f"
		}
	],
	"ratelimits": [
		{
			"name": "EMAIL_CHECK_RL",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"vars": {
		"MAILTRAP_SENDER": "puff@eustasy.org",
		"MAILTRAP_SENDER_NAME": "PuffAuth",
		"APP_URL": "https://puff-serverless.eustasy.org"
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
