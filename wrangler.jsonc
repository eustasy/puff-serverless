{
	"name": "puff-serverless",
	"main": "./dist/worker/index.js",
	"compatibility_date": "2026-03-22",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./public"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "404f36162d5341429d55bde35de77b9f"
		}
	],
	"rate_limits": [
		{
			"binding": "EMAIL_CHECK_RL",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	]
}
